# Скопируйте в .env и заполните значения.

# Секретный ключ Django. Обязателен при DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=

# Режим разработки: 1 — включён, 0 — боевой.
DJANGO_DEBUG=1

# Хосты через запятую.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Хостинг за HTTPS-прокси: 1 — доверять заголовку X-Forwarded-Proto.
# Нужно, чтобы Steam возвращал пользователя на https-адрес.
DJANGO_TRUST_PROXY_SSL_HEADER=0

# Регион и язык данных Steam Store. Регион us надёжнее: с cc=ru часть игр
# возвращает ошибку из-за региональных ограничений. Язык — английский,
# остальные локализации запрашиваются отдельно.
STEAM_COUNTRY=us
STEAM_LANGUAGE=english

# Время жизни кэша ответов Steam, секунды.
STEAM_CACHE_TTL=86400

# Steam Web API: ключ нужен только для ника и аватара при входе через
# Steam OpenID. Без ключа вход работает, но показывается техническое имя
# steam_<SteamID64>. Ключ бесплатный: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Epic Games Store: регион и язык названий, время жизни кэша.
# Регион и локаль — американские, как и у Steam.
EPIC_COUNTRY=US
EPIC_LOCALE=en
EPIC_CACHE_TTL=86400

# DeepL: ключ для перевода комментариев к отчётам. Без него кнопка
# «Перевести» не показывается. Бесплатный ключ заканчивается на «:fx».
DEEPL_API_KEY=
