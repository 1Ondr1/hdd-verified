# Скопируйте в .env и заполните значения.

# Секретный ключ Django. Обязателен при DJANGO_DEBUG=0.
DJANGO_SECRET_KEY=

# Режим разработки: 1 — включён, 0 — боевой.
DJANGO_DEBUG=1

# Хосты через запятую.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Хостинг за HTTPS-прокси: 1 — доверять заголовку X-Forwarded-Proto.
# Нужно, чтобы Steam возвращал пользователя на https-адрес.
DJANGO_TRUST_PROXY_SSL_HEADER=0

# Домены, которым разрешены POST-запросы (нужно для формы входа и Steam).
# Пример: https://hdd-verified.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Админка: секретный путь (без слэшей по краям) и SteamID64
# администраторов через запятую. Парольной формы нет — вход через Steam.
# Смена списка действует после перезапуска.
DJANGO_ADMIN_PATH=admin/
DJANGO_ADMIN_STEAM_IDS=76561198295815081

# Боевые флаги. По умолчанию при DJANGO_DEBUG=0 включены HTTPS-редирект,
# защищённые cookie и HSTS на год. Отключайте только для отладки.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_COOKIES=1
DJANGO_HSTS_SECONDS=31536000

# Уровень логов: DEBUG, INFO, WARNING, ERROR.
DJANGO_LOG_LEVEL=INFO

# PostgreSQL. Пусто — используется локальный db.sqlite3.
# Neon: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=
# sslmode, если его нет в адресе. Neon и Render требуют TLS.
DATABASE_SSLMODE=require
# Держать соединение открытым, секунды (0 — закрывать после запроса).
DATABASE_CONN_MAX_AGE=600

# Регион и язык данных Steam Store. Регион us надёжнее: с cc=ru часть игр
# возвращает ошибку из-за региональных ограничений. Язык — английский,
# остальные локализации запрашиваются отдельно.
STEAM_COUNTRY=us
STEAM_LANGUAGE=english

# Время жизни кэша ответов Steam, секунды.
STEAM_CACHE_TTL=86400

# Steam Web API: ключ нужен только для ника и аватара при входе через
# Steam OpenID. Без ключа вход работает, но показывается техническое имя
# steam_<SteamID64>. Ключ бесплатный: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Epic Games Store: регион и язык названий, время жизни кэша.
# Регион и локаль — американские, как и у Steam.
EPIC_COUNTRY=US
EPIC_LOCALE=en
EPIC_CACHE_TTL=86400

# DeepL: ключ для перевода комментариев к отчётам. Без него кнопка
# «Перевести» не показывается. Бесплатный ключ заканчивается на «:fx».
DEEPL_API_KEY=
# Сколько переводов один пользователь может сделать за сутки.
DEEPL_DAILY_LIMIT=20
